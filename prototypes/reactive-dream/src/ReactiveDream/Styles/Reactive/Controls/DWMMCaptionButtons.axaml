<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:ReactiveDream.Controls">


    <ControlTheme x:Key="ReactiveCaptionButtonBase"
                TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00808080" />
        <Setter Property="Foreground" Value="{DynamicResource Window.CaptionButton.Idle.Glyph.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Window.CaptionButton.Idle.Glyph.BorderBrush}" />
        <Setter Property="Width" Value="42"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="#01000000">
                    <DockPanel x:Name="ApparentRoot">
                        <Rectangle Classes="separator"
                                Fill="{DynamicResource Window.Border.Interior.InnerBorderBrush}"
                                Width="1"
                                DockPanel.Dock="Right" />
                        <Panel Classes="bg">
                            <Border Classes="bgcolor"
                                    Background="{TemplateBinding Background}" />
                            <Border Background="{DynamicResource Window.CaptionButton.Shine.BackgroundBrush}"
                                BorderBrush="#B2FFFFFF"
                                BorderThickness="1">
                                <Viewbox Stretch="Fill">
                                    <Rectangle Fill="{DynamicResource Window.CaptionButton.Idle.BackgroundBrush}"
                                                Width="42"
                                                Height="36" />
                                </Viewbox>
                            </Border>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                            Background="Transparent"
                                            Content="{TemplateBinding Content}"
                                            Margin="0,0,1,1"
                                            Padding="{TemplateBinding Padding}" />
                        </Panel>
                    </DockPanel>
                </Panel>
            </ControlTemplate>
        </Setter>


        <Style Selector="^:not(:last-child)">
            <Setter Property="Margin" Value="0,-10,0,0" />
        </Style>
        <Style Selector="^:not(:last-child) /template/ :is(Control)#ApparentRoot">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>


        <Style Selector="^:last-child">
            <Setter Property="Margin" Value="0,-10,-10,0" />
        </Style>
        <Style Selector="^:last-child /template/ :is(Control)#ApparentRoot">
            <Setter Property="Margin" Value="0,10,10,0" />
        </Style>


        <Style Selector="^ /template/ Panel.bg,
                        ^ /template/ Border.bgcolor">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Window.CaptionButton.FadeDuration}" />
                </Transitions>
            </Setter>
        </Style>
            
        <Style Selector="^ /template/ Border.bgcolor">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:pointerover /template/ Border.bgcolor">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled /template/ Panel.bg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="ReactiveCaptionButton"
                TargetType="{x:Type Button}"
                BasedOn="{StaticResource ReactiveCaptionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Window.CaptionButton.Hover.BackgroundBrush}" />
        
        <Style Selector="^ /template/ Border.bgcolor">
            <Setter Property="BoxShadow" Value="0 0 18 6 #FF80FFFF" />
        </Style>

        <Style Selector="^:pressed /template/ Border.bgcolor">
            <Setter Property="Background" Value="{DynamicResource Window.CaptionButton.Pressed.BackgroundBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="ReactiveCloseButton"
                TargetType="{x:Type Button}"
                BasedOn="{StaticResource ReactiveCaptionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Window.CloseButton.Hover.BackgroundBrush}" />
        
        <Style Selector="^ /template/ Border.bgcolor">
            <Setter Property="BoxShadow" Value="0 0 18 6 #FFFF8080" />
        </Style>

        <Style Selector="^:pressed /template/ Border.bgcolor">
            <Setter Property="Background" Value="{DynamicResource Window.CloseButton.Pressed.BackgroundBrush}" />
        </Style>

        <Style Selector="^ /template/ Rectangle.separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
    
    <ControlTheme x:Key="{x:Type ctl:MCaptionButtons}"
                TargetType="{x:Type ctl:MCaptionButtons}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxHeight" Value="28" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="LayoutRoot"
                        BorderBrush="{DynamicResource Window.Border.Interior.OuterBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="0,6,6,0"
                        Classes.noResize="{Binding !CanResize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ctl:MWindowBase}}, Mode=OneWay}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Window.Border.Interior.InnerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="1">
                        <StackPanel Orientation="Horizontal"
                                    TextElement.FontSize="10">
                            <Button x:Name="PART_FullScreenButton"
                                    Theme="{StaticResource ReactiveCaptionButton}"
                                    IsVisible="False"
                                    Classes="hide-when-no-resize">
                                <!--
                                <Viewbox Width="11" Margin="2">
                                    <Path Name="FullScreenButtonPath"
                                        Stretch="UniformToFill"
                                        Fill="{TemplateBinding Foreground}"
                                        Data="M2048 2048v-819h-205v469l-1493 -1493h469v-205h-819v819h205v-469l1493 1493h-469v205h819z" />
                                </Viewbox>
                                -->
                            </Button>
                            <Button x:Name="PART_MinimizeButton"
                                    Theme="{StaticResource ReactiveCaptionButton}"
                                    AutomationProperties.Name="Minimize"
                                    Classes="hide-when-no-resize">
                                <Panel>
                                    <Path Classes="stroke"
                                        Data="{Binding #MinIcon.Data}" />
                                    <Path x:Name="MinIcon"
                                        Data="M 1 6 H 9 V 8 H 1 Z" />
                                </Panel>
                            </Button>
                            <Button x:Name="PART_RestoreButton"
                                    Theme="{StaticResource ReactiveCaptionButton}"
                                    AutomationProperties.Name="Maximize"
                                    Classes="hide-when-no-resize">
                                <Panel>
                                    <Path Classes="stroke"
                                        Data="{Binding #MaxIcon.Data}" />
                                    <Path x:Name="MaxIcon"
                                        Data="M 1 1 H 9 V 9 H 1 Z
                                            M 3 3 H 7 V 7 H 3 Z" />
                                </Panel>
                            </Button>
                            <Button x:Name="PART_CloseButton"
                                    Theme="{StaticResource ReactiveCloseButton}"
                                    AutomationProperties.Name="Close">
                                <Panel>
                                    <Path Classes="stroke"
                                        Data="{Binding #CloseIcon.Data}" />
                                    <Path x:Name="CloseIcon"
                                        Data="M 1 1
                                        H 2.5 L 5 3.5 L 7.5 1 H 9
                                        V 2.5 L 6.5 5 L 9 7.5 V 9
                                        H 7.5 L 5 6.5 L 2.5 9 H 1
                                        V 7.5 L 3.5 5 L 1 2.5 Z" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Button > Panel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ Button Path.stroke">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
        <Style Selector="^ /template/ Button Path:not(.stroke)">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="^ /template/ Border#LayoutRoot.noResize Button.hide-when-no-resize">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
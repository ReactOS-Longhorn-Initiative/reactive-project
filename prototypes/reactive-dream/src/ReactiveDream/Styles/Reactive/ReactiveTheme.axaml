<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:ReactiveDream.Styles"
        x:Class="ReactiveDream.Styles.ReactiveTheme">

    <!-- Avalonia Fluent theme used for placeholders only-->
    <FluentTheme />


    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ReactiveDream/Styles/Reactive/Resources.axaml" />
                <ResourceInclude Source="avares://ReactiveDream/Styles/Reactive/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
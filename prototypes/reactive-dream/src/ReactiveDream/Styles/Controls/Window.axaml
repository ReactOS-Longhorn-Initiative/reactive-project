<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:ReactiveDream.Controls">
    <ControlTheme x:Key="{x:Type ctl:MWindow}"
                TargetType="{x:Type ctl:MWindow}"
                BasedOn="{StaticResource WindowBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource Window.Border.OpaqueBrush}" />
        <!--
        <Style Selector="^ /template/ Border#FrameRoot">
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
        </Style>
        -->


        <!--
        <Style Selector="^ /template/ :is(Control)#ClientArea > Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^ /template/ :is(Control)#ClientArea > Border > Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="2" />
        </Style>
        -->
        <Style Selector="^ /template/ Border#InteriorBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
        </Style>


        <Style Selector="^[IsMaximized=False]">
            <Style Selector="^ /template/ Panel#TitlebarArea > Panel">
                <Setter Property="Margin" Value="0,2,2,0" />
            </Style>
            <Style Selector="^ /template/ TextBlock#TitlebarText">
                <Setter Property="Margin" Value="0,2,0,-2" />
            </Style>
            <!--
            <Style Selector="^ /template/ ctl|MCaptionButtons#PART_CaptionButtons">
                <Setter Property="Margin" Value="0,-8,-8,0" />
            </Style>
            -->
        </Style>


        <Style Selector="^[AnimationState=Closing]">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
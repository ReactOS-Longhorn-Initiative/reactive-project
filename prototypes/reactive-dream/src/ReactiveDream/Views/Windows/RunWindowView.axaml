<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReactiveDream.Views.RunWindowView">
    <UserControl.Styles>
        <Style Selector=":is(Control)#Footer Button">
            <Setter Property="Width" Value="89" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="11,18"
        ColumnDefinitions="32,11,*"
        RowDefinitions="Auto,10,21,*,Auto">
        <ContentControl Theme="{DynamicResource Placeholder}"
                        Width="32"
                        Height="32"
                        Grid.Column="0"
                        Grid.Row="0" />

        <TextBlock Text="Type the name of a program, folder, document, or Internet resource, and ReactOS will open it for you."
                TextWrapping="Wrap"
                Grid.Column="2"
                Grid.Row="0" />


            <TextBlock Text="Open:"
                    Grid.Column="0"
                    Grid.Row="2" />
            <AutoCompleteBox
                    Grid.Column="2"
                    Grid.Row="2" />


        <StackPanel x:Name="Footer"
                    Orientation="Horizontal"
                    Spacing="2"
                    HorizontalAlignment="Right"
                    Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="3">
            <Button Content="OK"
                    IsEnabled="False" />
            <Button Content="Cancel"
                    Command="{Binding CloseCommand, Mode=OneWay}" />
            <Button Content="Browse..." />
        </StackPanel>
    </Grid>
</UserControl>
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_desktop_net8",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/ReactiveDream.Desktop/ReactiveDream.Desktop.net8-0.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
